# ── LLM Provider Configuration ───────────────────────────────────────────────
# Copy this file to .env and fill in your settings.

# Option 1: OpenAI (cloud)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
OPENAI_BASEURL=https://api.openai.com/v1

# Option 2: Ollama (local, zero API cost)
# Start Ollama first: ollama serve
# Pull a model: ollama pull qwen2.5-coder:14b
# Then set:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen2.5-coder:14b
# OPENAI_BASEURL=http://localhost:11434/v1

# Option 3: LM Studio (local)
# Enable "Serve on Local Network" in LM Studio, then:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=lm-studio
# LLM_MODEL=qwen2.5-coder-14b-instruct   # match model ID from /v1/models
# OPENAI_BASEURL=http://192.168.x.x:1234/v1
